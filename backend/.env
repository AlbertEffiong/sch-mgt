# ============================================================================
# Syntax SaaS PHP Backend - environment configuration
# ============================================================================

# Runtime
APP_ENV=development
PORT=4000

# SQLite database file (relative to the backend directory)
DB_PATH=database/syntax_saas.sqlite

# Security
JWT_SECRET=a3e740b8240a5cc97c2c439151e87ab5bb9d773a8e3011bf
JWT_EXPIRES_IN=1d

# Comma-separated list of trusted frontend origins (CORS allowlist).
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:4000,http://127.0.0.1:4000
# Cookies: set COOKIE_SECURE=true when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting (auth routes use RATE_LIMIT_MAX, global uses RATE_LIMIT_MAX * 30)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Password hashing cost.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# OPay manual bank-transfer verification (display only)
# ---------------------------------------------------------------------------
OPAY_ACCOUNT_NUMBER=8168998060
OPAY_ACCOUNT_NAME=Albert Effiong

# ---------------------------------------------------------------------------
# Bootstrap owner (used by `php bin/seed.php`)
# Passwords below match the demo credentials pre-filled by the frontend.
# ---------------------------------------------------------------------------
OWNER_NAME=SaaS Owner
OWNER_EMAIL=owner@syntaxsaas.io
OWNER_PASSWORD=master123
