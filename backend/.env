# ============================================================================
# Syntax SaaS PHP Backend - environment configuration
# ============================================================================

# Runtime
APP_ENV=development
PORT=4000

# MySQL (XAMPP defaults shown). The database is created automatically on the
# first run if it does not exist and the MySQL user has CREATE privileges.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=syntax_saas
DB_USER=root
DB_PASS=

# Security
JWT_SECRET=a3e740b8240a5cc97c2c439151e87ab5bb9d773a8e3011bf
JWT_EXPIRES_IN=1d

# Comma-separated trusted frontend origins (CORS allowlist).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1,http://localhost:4000,http://127.0.0.1:4000
# Cookies: set COOKIE_SECURE=true when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting (auth routes use RATE_LIMIT_MAX, global uses RATE_LIMIT_MAX * 30)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Password hashing cost.
BCRYPT_ROUNDS=12

# Temporary verification codes (replace with a delivered, expiring OTP service
# before production: school registration + admin sign-in).
SCHOOL_REGISTRATION_OTP=081689
ADMIN_LOGIN_OTP=081689

# ---------------------------------------------------------------------------
# OPay manual bank-transfer verification (display only)
# ---------------------------------------------------------------------------
OPAY_ACCOUNT_NUMBER=8168998060
OPAY_ACCOUNT_NAME=Albert Effiong

# ---------------------------------------------------------------------------
# Bootstrap owner (used by `php bin/seed.php`)
# ---------------------------------------------------------------------------
OWNER_NAME=SaaS Owner
OWNER_EMAIL=owner@syntaxsaas.io
OWNER_PASSWORD=Owner@123
