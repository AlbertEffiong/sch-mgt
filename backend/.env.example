# Copy this file to `.env` and adjust the values for your environment.

APP_ENV=development
PORT=4000

# MySQL connection (PDO). Create the database or let the first run create it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=syntax_saas
DB_USER=root
DB_PASS=

# Use a long, random secret in production (e.g. `openssl rand -hex 48`).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1,http://localhost:4000

COOKIE_SECURE=false
COOKIE_DOMAIN=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

BCRYPT_ROUNDS=12

# Verification codes (replace with a real OTP delivery service in production).
SCHOOL_REGISTRATION_OTP=081689
ADMIN_LOGIN_OTP=081689

# OPay manual bank transfer destination (shown on the payment lock screen).
OPAY_ACCOUNT_NUMBER=8168998060
OPAY_ACCOUNT_NAME=Albert Effiong

OWNER_NAME=SaaS Owner
OWNER_EMAIL=owner@syntaxsaas.io
OWNER_PASSWORD=Owner@123
